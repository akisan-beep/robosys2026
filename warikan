import sys


def main():
    if len(sys.argv) != 3:
        print("使い方: warikan 金額 人数", file=sys.stderr)
        return 1

    try:
        amount = int(sys.argv[1])
        people = int(sys.argv[2])
    except ValueError:
        print("金額と人数は整数で指定してください", file=sys.stderr)
        return 1

    if amount < 0:
        print("金額は0以上にしてください", file=sys.stderr)
        return 1

    if people <= 0:
        print("人数は1以上にしてください", file=sys.stderr)
        return 1

    per_person, remainder = divmod(amount, people)

    print(per_person)
    print(remainder)
    return 0


if __name__ == "__main__":
    sys.exit(main())
